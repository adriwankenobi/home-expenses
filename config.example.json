{
  "currency": "EUR",
  "bank_statements": {
    "dir": "/path/to/bank_statements",
    "glob": "*.csv"
  },
  "match_window_days_default": 30,
  "categories": {
    "Energy": {
      "invoice_folder": "/path/to/invoices/pepeenergy",
      "invoice_parser": "pepeenergy",
      "recurrence": "monthly",
      "patterns": ["PEPE ENERGY INVOICE"],
      "match_window_days": 15,
      "start_date": "2024-01"
    },
    "Mobile Phone": {
      "invoice_folder": "/path/to/invoices/pepephone",
      "invoice_parser": "pepephone",
      "recurrence": "none",
      "patterns": ["PEPE MOBILE INVOICE"],
      "match_window_days": 15
    },
    "IBI": {
      "invoice_folder": "/path/to/invoices/ibi",
      "invoice_parser": "ibi",
      "recurrence": "quarterly",
      "patterns": ["IBI INVOICE"]
    },
    "Water and Waste": {
      "invoice_folder": "/path/to/invoices/aguasYBasuras",
      "invoice_parser": "aguasYBasuras",
      "recurrence": "quarterly",
      "patterns": ["WATER AND WASTE INVOICE"]
    },
    "Sanitation": {
      "invoice_folder": "/path/to/invoices/ecociudad",
      "invoice_parser": "ecociudad",
      "recurrence": "quarterly",
      "patterns": ["SANITATION INVOICE"]
    },
    "Hot Water": {
      "invoice_folder": "/path/to/invoices/ullastresAgua",
      "invoice_parser": "ullastresAguaYGas",
      "recurrence": "monthly",
      "patterns": ["HOT WATER INVOICE"]
    },
    "Heating": {
      "invoice_folder": "/path/to/invoices/ullastresGas",
      "invoice_parser": "ullastresAguaYGas",
      "recurrence": "monthly",
      "patterns": ["HEATING INVOICE"]
    },
    "monthly": {
      "patterns": ["MONTHLY INVOICE"],
      "recurrence": "monthly"
    },
    "bimonthly": {
      "patterns": ["BIMONTHLY INVOICE"],
      "recurrence": "bimonthly"
    },
    "quarterly": {
      "patterns": ["QUARTERLY INVOICE"],
      "recurrence": "quarterly"
    },
    "yearly": {
      "patterns": ["ANNUAL INVOICE"],
      "recurrence": "yearly",
      "period_contains_payment": true
    },
    "sharedQuarterly1": {
      "patterns": ["SHARED QUARTERLY INVOICE"],
      "recurrence": "quarterly"
    },
    "sharedQuarterly2": {
      "patterns": ["SHARED QUARTERLY INVOICE"],
      "recurrence": "quarterly",
      "start_date": "2024-Q3"
    }
  },
  "manual_mappings": {
    "UNIQUE ANNUAL CHARGE": {
      "category": "sharedQuarterly1",
      "recurrence": "yearly",
      "period_contains_payment": true
    }
  }
}
