{
  "currency": "EUR",
  "bank_statements": {
    "dir": "/path/to/bank_statements",
    "glob": "*.csv"
  },
  "match_window_days_default": 30,
  "categories": {
    "PepeEnergy": {
      "invoice_folder": "/path/to/invoices/pepeenergy",
      "invoice_parser": "pepeenergy",
      "recurrence": "monthly",
      "patterns": ["RECIBO PEPE ENERGY"],
      "match_window_days": 15,
      "start_date": "2024-01"
    },
    "PepePhone": {
      "invoice_folder": "/path/to/invoices/pepephone",
      "invoice_parser": "pepephone",
      "recurrence": "none",
      "patterns": ["RECIBO Pepe Mobile, S.L.U."],
      "match_window_days": 15
    },
    "monthly": {
      "patterns": ["RECIBO MENSUAL"],
      "recurrence": "monthly"
    },
    "bimonthly": {
      "patterns": ["RECIBO BIMENSUAL"],
      "recurrence": "bimonthly"
    },
    "quarterly": {
      "patterns": ["RECIBO TRIMESTRAL"],
      "recurrence": "quarterly"
    },
    "yearly": {
      "patterns": ["RECIBO ANUAL"],
      "recurrence": "yearly"
    }
  },
  "manual_mappings": {}
}
