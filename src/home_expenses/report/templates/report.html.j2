<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Home Expenses Report · {{ model.generated_at }}</title>
<style>
  body { background: #1a1a1a; color: #ddd; font-family: -apple-system, BlinkMacSystemFont, sans-serif; margin: 0; padding: 24px; }
  h1, h2, h3 { color: #fff; }
  .header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 16px; }
  .year-tabs { display: flex; gap: 4px; }
  .year-tab { padding: 6px 12px; background: #2d2d2d; border: 1px solid #555; border-radius: 4px; font-size: 12px; color: #ccc; cursor: pointer; }
  .year-tab.active { background: #094771; border-color: #007acc; color: #fff; }
  .section { margin: 24px 0; padding: 16px; background: #1f1f1f; border-radius: 8px; border: 1px solid #333; }
  .alert { padding: 8px 12px; background: #3a1e1e; border-left: 4px solid #f48771; margin: 6px 0; border-radius: 4px; }
  .kpi-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .kpi { background: #2d2d2d; padding: 16px; border-radius: 6px; text-align: center; }
  /* General KPI cards use a neutral white so the per-category cards' colored
     totals are the only colored numbers in the Summary section. */
  .kpi .big { font-size: 24px; font-weight: bold; color: #fff; }
  .kpi .label { font-size: 11px; color: #aaa; text-transform: uppercase; margin-top: 4px; }
  /* Per-category cards mirror the KPI card style (dark bg, big green
     number, small uppercase label) but add a colored top border keyed to
     the category color so they connect visually to the charts. Below the
     big total, two mini-KPIs (transactions / avg lag) sit in a 2-col grid
     that recurses the same big-number-plus-label pattern. */
  .cat-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; margin-top: 12px; }
  .cat-card { background: #2d2d2d; padding: 16px; border-radius: 6px; text-align: center; border-top: 3px solid #4ec9b0; }
  .cat-card .cat-name { font-size: 13px; font-weight: bold; color: #fff; margin-bottom: 8px; text-transform: lowercase; }
  /* cat-total color is set per-card via inline style to match the category. */
  .cat-card .cat-total { font-size: 22px; font-weight: bold; margin-bottom: 10px; }
  .cat-card .cat-divider { height: 1px; background: #444; margin: 0 8px 10px; }
  .cat-card .cat-subkpis { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .cat-card .sub { display: flex; flex-direction: column; }
  .cat-card .sub-value { font-size: 16px; font-weight: bold; color: #ddd; }
  .cat-card .sub-label { font-size: 10px; color: #aaa; text-transform: uppercase; margin-top: 2px; }
  .item-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .item-table th, .item-table td { padding: 6px 10px; text-align: left; border-bottom: 1px solid #333; }
  .item-table th { color: #888; text-transform: uppercase; font-size: 11px; }
  .item-table tr.highlighted { background: #094771; }
  /* Anchors inside the items table inherit the row color so the 📎 invoice
     link matches the rest of the category-tinted row. */
  .item-table a { color: inherit; }
  a { color: #4ec9b0; text-decoration: none; }
  .chart-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  /* Static charts: default cursor everywhere; only flip to pointer when the
     hover handler marks a data point under the cursor. */
  #chart-spent, #chart-spent *,
  #chart-consumed, #chart-consumed *,
  #chart-timeline, #chart-timeline * { cursor: default; }
  #chart-spent.cursor-pointer, #chart-spent.cursor-pointer *,
  #chart-consumed.cursor-pointer, #chart-consumed.cursor-pointer *,
  #chart-timeline.cursor-pointer, #chart-timeline.cursor-pointer * {
    cursor: pointer !important;
  }
</style>
</head>
<body>

<div class="header">
  <h1>Home Expenses · {{ model.generated_at }}</h1>
  <div class="year-tabs" id="year-tabs">
    <div class="year-tab active" data-year="all">All</div>
    {% for y in model.years %}
    <div class="year-tab" data-year="{{ y }}">{{ y }}</div>
    {% endfor %}
  </div>
</div>

<div class="section">
  <h2>Alerts</h2>
  {% if model.alerts %}
    {% for a in model.alerts %}
      <div class="alert" data-kind="{{ a.kind.value }}">
        <strong>{{ a.kind.value }}</strong> — {{ a.message }}
      </div>
    {% endfor %}
  {% else %}
    <p>No alerts. Everything reconciles.</p>
  {% endif %}
</div>

<div class="section">
  <h2>Summary</h2>
  <div class="kpi-row">
    <div class="kpi"><div class="big" id="kpi-total">—</div><div class="label">Total</div></div>
    <div class="kpi"><div class="big" id="kpi-txns">—</div><div class="label">Transactions</div></div>
    <div class="kpi"><div class="big" id="kpi-cats">—</div><div class="label">Categories</div></div>
    <div class="kpi"><div class="big" id="kpi-alerts">{{ model.alerts | length }}</div><div class="label">Open alerts</div></div>
  </div>
  <div class="cat-grid" id="cat-grid"></div>
</div>

<div class="section">
  <h2>Monthly spend <small style="color:#888;font-weight:normal">(when the bank charged)</small></h2>
  <div id="chart-spent"></div>
</div>

<div class="section">
  <h2>Monthly consumption <small style="color:#888;font-weight:normal">(when the service was used; periods spanning &gt;1 month split proportionally by day count)</small></h2>
  <div id="chart-consumed"></div>
</div>

<div class="section">
  <h2>By category</h2>
  <div id="chart-donut"></div>
</div>

<div class="section">
  <h2>Timeline</h2>
  <div id="chart-timeline"></div>
</div>

<div class="section">
  <h2>Items</h2>
  <table class="item-table" id="items">
    <thead>
      <tr>
        <th>Period</th><th>Invoice date</th><th>Payment date</th><th>Description</th><th>Amount</th>
        <th>Category</th><th>Invoice</th>
      </tr>
    </thead>
    <tbody id="items-body">
      {% for it in model.items|sort(attribute='transaction.date', reverse=True) %}
      <tr id="item-{{ loop.index0 }}" data-item-id="{{ loop.index0 }}">
        <td>{% if it.invoice %}{{ it.invoice.period.start }} → {{ it.invoice.period.end }}{% endif %}</td>
        <td>{% if it.invoice %}{{ it.invoice.invoice_date }}{% endif %}</td>
        <td>{{ it.transaction.date }}</td>
        <td>{{ it.transaction.description }}</td>
        <td>{{ it.transaction.amount }}</td>
        <td>{{ it.category }}</td>
        <td>{% if it.invoice %}<a href="file://{{ it.invoice.source_path }}" target="_blank">📎</a>{% endif %}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>

<script>{{ plotly_js | safe }}</script>
<script id="model-data" type="application/json">{{ data_json | safe }}</script>
<script>
(function () {
  const data = JSON.parse(document.getElementById('model-data').textContent);
  let activeYear = 'all';

  function filtered() {
    if (activeYear === 'all') return data.items;
    return data.items.filter(it => it.date.startsWith(activeYear + '-'));
  }

  const PALETTE = [
    '#4ec9b0', '#f48771', '#dcdcaa', '#9cdcfe', '#c586c0', '#ce9178',
    '#569cd6', '#b5cea8', '#d7ba7d', '#646695', '#4fc1ff', '#d16969',
  ];

  function buildCategoryColors(allItems) {
    // Build the map from the ENTIRE dataset so colors stay stable across
    // year filters (the same category always gets the same color).
    const cats = Array.from(new Set(allItems.map(it => it.category))).sort();
    const map = {};
    cats.forEach((cat, i) => { map[cat] = PALETTE[i % PALETTE.length]; });
    return map;
  }

  function highlightItems(ids) {
    if (!ids || ids.length === 0) return;
    let first = null;
    ids.forEach(id => {
      const row = document.getElementById('item-' + id);
      if (row) {
        row.classList.add('highlighted');
        setTimeout(() => row.classList.remove('highlighted'), 2000);
        if (first === null) first = row;
      }
    });
    if (first) first.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  function attachPointerCursor(div) {
    // Use a CSS class with !important to override Plotly's internal cursor
    // (its draglayer sets crosshair/default depending on dragmode).
    div.on('plotly_hover', () => div.classList.add('cursor-pointer'));
    div.on('plotly_unhover', () => div.classList.remove('cursor-pointer'));
  }

  // Plotly config / layout shared by both interactive charts: no zoom, no
  // pan, no double-click reset — just hover + click + the click handlers
  // attached per chart.
  const STATIC_CONFIG = { displayModeBar: false, scrollZoom: false, doubleClick: false };
  const STATIC_LAYOUT_BASE = {
    dragmode: false,
    paper_bgcolor: '#1f1f1f',
    plot_bgcolor: '#1f1f1f',
    font: { color: '#ddd' },
    margin: { t: 20 },
  };

  const colorMap = buildCategoryColors(data.items);

  // Darken a hex color toward black by multiplying RGB by `factor`. Used to
  // derive a tooltip background from the category color.
  function darken(hex, factor) {
    const n = parseInt(hex.slice(1), 16);
    const r = Math.round(((n >> 16) & 0xff) * factor);
    const g = Math.round(((n >> 8) & 0xff) * factor);
    const b = Math.round((n & 0xff) * factor);
    return '#' + ((r << 16) | (g << 8) | b).toString(16).padStart(6, '0');
  }

  // Currency symbol used in all tooltips and the items-table amount column.
  // Position is currency-aware: EUR/JPY render the symbol after the number
  // (e.g. "78.42 €"); USD/GBP render it before (e.g. "$78.42"). Unknown
  // currencies fall back to the ISO code prefixed before the value.
  const CURRENCY_SYMBOLS = { EUR: '€', USD: '$', GBP: '£', JPY: '¥' };
  const SYMBOL_AFTER = new Set(['EUR', 'JPY']);
  const currencySymbol = CURRENCY_SYMBOLS[data.currency] || data.currency;
  const symbolAfter = SYMBOL_AFTER.has(data.currency);
  function formatAmount(value) {
    const n = parseFloat(value).toFixed(2);
    return symbolAfter ? n + ' ' + currencySymbol : currencySymbol + n;
  }
  function fmtAmountTemplate(numberToken) {
    // Build a Plotly hovertemplate fragment that places the currency symbol
    // in the correct position relative to the number token (e.g. "%{y:.2f}").
    return symbolAfter ? numberToken + ' ' + currencySymbol : currencySymbol + numberToken;
  }

  // ---- date helpers ----
  function days(a, b) { return Math.round((Date.parse(b) - Date.parse(a)) / 86400000); }
  function daysInclusive(a, b) { return days(a, b) + 1; }
  function pad2(n) { return String(n).padStart(2, '0'); }

  // For items lacking a real invoice (pattern- or manual-matched), guess
  // the period and invoice date from the category's recurrence: assume
  // the payment is for the period immediately PRIOR to the one containing
  // the payment date. Quarterly payment in April → Q1; monthly April →
  // March; bimonthly April → Jan–Feb; yearly 2026 → 2025. Returns null
  // for "none". invoice_date is the last day of the synthetic period.
  function syntheticPeriodFor(paymentIso, recurrence) {
    if (!recurrence || recurrence === 'none') return null;
    const d = new Date(paymentIso + 'T00:00:00');
    const y = d.getFullYear();
    const m = d.getMonth(); // 0-based

    let width, containingStartMonth;
    switch (recurrence) {
      case 'monthly':   width = 1;  containingStartMonth = m; break;
      case 'bimonthly': width = 2;  containingStartMonth = Math.floor(m / 2) * 2; break;
      case 'quarterly': width = 3;  containingStartMonth = Math.floor(m / 3) * 3; break;
      case 'yearly':    width = 12; containingStartMonth = 0; break;
      default: return null;
    }
    let startMonth = containingStartMonth - width;
    let startYear = y;
    if (startMonth < 0) { startMonth += 12; startYear -= 1; }
    const endMonth = startMonth + width - 1;
    const lastDay = new Date(startYear, endMonth + 1, 0).getDate();
    const start = `${startYear}-${pad2(startMonth + 1)}-01`;
    const end = `${startYear}-${pad2(endMonth + 1)}-${pad2(lastDay)}`;
    return { period_start: start, period_end: end, invoice_date: end };
  }

  // Return the period/invoice info to DISPLAY for an item: real values if
  // present (invoice attached), otherwise synthesized from the category's
  // recurrence. Returns null if there's nothing to display (no invoice and
  // recurrence is 'none' or unknown).
  function displayInfoFor(it) {
    if (it.period_start && it.period_end && it.invoice_date) {
      return {
        period_start: it.period_start,
        period_end: it.period_end,
        invoice_date: it.invoice_date,
        synthetic: false,
      };
    }
    const synth = syntheticPeriodFor(it.date, data.categories[it.category]);
    if (synth === null) return null;
    return { ...synth, synthetic: true };
  }
  function splitPeriodAcrossMonths(start, end) {
    // Returns { 'YYYY-MM': fraction } summing to 1 across the months the
    // period covers, weighted by day count in each month.
    const out = {};
    const total = daysInclusive(start, end);
    let cur = new Date(start + 'T00:00:00');
    const endD = new Date(end + 'T00:00:00');
    while (cur <= endD) {
      const y = cur.getFullYear();
      const m = cur.getMonth();
      const monthEnd = new Date(y, m + 1, 0);
      const sliceEnd = monthEnd <= endD ? monthEnd : endD;
      const key = String(y) + '-' + String(m + 1).padStart(2, '0');
      const sliceDays = Math.round((sliceEnd - cur) / 86400000) + 1;
      out[key] = (out[key] || 0) + sliceDays / total;
      cur = new Date(y, m + 1, 1);
    }
    return out;
  }

  // For items lacking a real invoice, fold the synthesized period/invoice
  // date into the item so every downstream renderer sees a single,
  // consistent view (table, monthly consumption, timeline).
  function enrichItems(items) {
    return items.map(it => {
      if (it.period_start && it.period_end && it.invoice_date) return it;
      const info = displayInfoFor(it);
      if (info === null) return it;
      return Object.assign({}, it, {
        period_start: info.period_start,
        period_end: info.period_end,
        invoice_date: info.invoice_date,
      });
    });
  }

  function render() {
    const items = enrichItems(filtered());
    const total = items.reduce((s, it) => s + parseFloat(it.amount), 0);
    document.getElementById('kpi-total').textContent = formatAmount(total);
    document.getElementById('kpi-txns').textContent = items.length;
    document.getElementById('kpi-cats').textContent =
      new Set(items.map(it => it.category)).size;
    renderCategoryBreakdown(items);
    renderItemsTable(items);
    renderSpent(items);
    renderConsumed(items);
    renderDonut(items);
    renderTimeline(items);
  }

  function renderCategoryBreakdown(items) {
    // Per-category KPI cards (one card per category) styled like the main
    // KPI strip. Total amount is the big number; items count and avg lag
    // appear as small uppercase meta lines below.
    const byCat = {};
    items.forEach(it => {
      byCat[it.category] = byCat[it.category]
        || { total: 0, count: 0, invoiced: 0, lags: [] };
      const c = byCat[it.category];
      c.total += parseFloat(it.amount);
      c.count += 1;
      if (it.invoice_path) c.invoiced += 1;
      if (it.period_end && it.date) c.lags.push(days(it.period_end, it.date));
    });
    const cats = Object.keys(byCat).sort();
    const grid = document.getElementById('cat-grid');
    grid.innerHTML = '';
    cats.forEach(cat => {
      const c = byCat[cat];
      const avgLagValue = c.lags.length === 0
        ? '—'
        : Math.round(c.lags.reduce((s, n) => s + n, 0) / c.lags.length) + ' days';
      const txnsValue = c.invoiced === c.count
        ? String(c.count)
        : c.invoiced + ' / ' + c.count;
      const card = document.createElement('div');
      card.className = 'cat-card';
      card.style.borderTopColor = colorMap[cat];
      card.innerHTML =
        '<div class="cat-name">' + escapeHtml(cat) + '</div>' +
        '<div class="cat-total" style="color:' + colorMap[cat] + '">' +
          formatAmount(c.total) + '</div>' +
        '<div class="cat-divider"></div>' +
        '<div class="cat-subkpis">' +
          '<div class="sub">' +
            '<div class="sub-value">' + txnsValue + '</div>' +
            '<div class="sub-label">Transactions</div>' +
          '</div>' +
          '<div class="sub">' +
            '<div class="sub-value">' + avgLagValue + '</div>' +
            '<div class="sub-label">Avg lag</div>' +
          '</div>' +
        '</div>';
      grid.appendChild(card);
    });
  }

  function renderItemsTable(items) {
    // data.items is pre-sorted by date desc upstream; `items` (filtered)
    // preserves that order, so simple iteration produces a desc table.
    const tbody = document.getElementById('items-body');
    tbody.innerHTML = '';
    items.forEach((it, idx) => {
      const tr = document.createElement('tr');
      tr.id = 'item-' + idx;
      tr.dataset.itemId = idx;
      const catColor = colorMap[it.category];
      const info = displayInfoFor(it);
      let periodCell = '';
      let invoiceDateCell = '';
      if (info) {
        const d = daysInclusive(info.period_start, info.period_end);
        periodCell = info.period_start + ' → ' + info.period_end +
          ' (' + d + ' day' + (d === 1 ? '' : 's') + ')';
        invoiceDateCell = info.invoice_date;
      }
      tr.innerHTML =
        '<td>' + periodCell + '</td>' +
        '<td>' + invoiceDateCell + '</td>' +
        '<td>' + it.date + '</td>' +
        '<td>' + escapeHtml(it.description) + '</td>' +
        '<td>' + formatAmount(it.amount) + '</td>' +
        '<td>' + escapeHtml(it.category) + '</td>' +
        '<td>' + (it.invoice_path
          ? '<a href="file://' + escapeHtml(it.invoice_path) + '" target="_blank">📎</a>'
          : '') + '</td>';
      // Entire row tinted in the category color, plus a thicker left ribbon.
      tr.style.color = catColor;
      tr.firstElementChild.style.borderLeft = '3px solid ' + catColor;
      tbody.appendChild(tr);
    });
  }

  // Builds a stacked-bar monthly chart, aggregating amounts under a
  // category-supplied attribution rule. `attribute(item, idx)` returns a map
  // of 'YYYY-MM' → amount (allowing one item to contribute to many months).
  // Each bar segment carries the indices of the items it aggregates so a
  // click can jump to them in the items list.
  function renderMonthlyChart(divId, items, attribute) {
    const monthSet = new Set();
    const byCat = {};       // byCat[cat][month] = summed amount
    const cellIndices = {}; // cellIndices[cat][month] = [item indices]
    items.forEach((it, i) => {
      const contrib = attribute(it, i);
      for (const m in contrib) {
        monthSet.add(m);
        byCat[it.category] = byCat[it.category] || {};
        byCat[it.category][m] = (byCat[it.category][m] || 0) + contrib[m];
        cellIndices[it.category] = cellIndices[it.category] || {};
        cellIndices[it.category][m] = cellIndices[it.category][m] || [];
        cellIndices[it.category][m].push(i);
      }
    });
    const months = Array.from(monthSet).sort();
    const cats = Object.keys(byCat).sort();
    const traces = cats.map(cat => ({
      x: months,
      y: months.map(m => byCat[cat][m] || 0),
      name: cat,
      type: 'bar',
      marker: { color: colorMap[cat] },
      customdata: months.map(m => (cellIndices[cat] && cellIndices[cat][m]) || []),
      hovertemplate:
        '<b>' + cat + '</b><br>%{x|%b %Y}<br>' + fmtAmountTemplate('%{y:.2f}') + '<extra></extra>',
    }));
    Plotly.newPlot(divId, traces, Object.assign({}, STATIC_LAYOUT_BASE, {
      barmode: 'stack',
    }), STATIC_CONFIG);
    const div = document.getElementById(divId);
    div.on('plotly_click', evt => {
      highlightItems(evt.points[0].customdata || []);
    });
    attachPointerCursor(div);
  }

  function renderSpent(items) {
    // Spent: amount lands on the month of the bank charge.
    renderMonthlyChart('chart-spent', items, it => {
      const m = it.date.slice(0, 7);
      return { [m]: parseFloat(it.amount) };
    });
  }

  function renderConsumed(items) {
    // Consumption: only items with a period contribute; amount is split
    // proportionally by day count across the months the period covers.
    renderMonthlyChart('chart-consumed', items, it => {
      if (!it.period_start || !it.period_end) return {};
      const split = splitPeriodAcrossMonths(it.period_start, it.period_end);
      const amount = parseFloat(it.amount);
      const out = {};
      for (const m in split) out[m] = amount * split[m];
      return out;
    });
  }

  function renderDonut(items) {
    const byCat = {};
    items.forEach(it => {
      byCat[it.category] = (byCat[it.category] || 0) + parseFloat(it.amount);
    });
    const labels = Object.keys(byCat);
    Plotly.newPlot('chart-donut', [{
      labels: labels,
      values: Object.values(byCat),
      type: 'pie',
      hole: 0.5,
      marker: { colors: labels.map(c => colorMap[c]) },
      sort: false,
      hovertemplate:
        '<b>%{label}</b><br>' + fmtAmountTemplate('%{value:.2f}') + ' (%{percent})<extra></extra>',
    }], { paper_bgcolor: '#1f1f1f', font: { color: '#ddd' }, margin: { t: 20 } }, { displayModeBar: false });
  }

  function renderTimeline(items) {
    // Each item is drawn at y=amount as a horizontal "lifecycle":
    //   - thick bar from period_start to period_end (consumption window)
    //   - thin solid line from period_end to invoice_date
    //   - thin dotted line from invoice_date to payment_date
    //   - open diamond at invoice_date
    //   - filled dot at payment_date (the ONLY hoverable element)
    // Every element of an item uses the item's category color so multi-
    // category timelines stay legible. Traces are grouped by category
    // (5 traces per category) because Plotly applies one color per trace.
    const cats = Array.from(new Set(items.map(it => it.category))).sort();
    const catData = {};
    cats.forEach(cat => {
      catData[cat] = {
        periodLineX: [], periodLineY: [],
        lagLineX: [], lagLineY: [],
        waitLineX: [], waitLineY: [],
        invX: [], invY: [],
        payX: [], payY: [], payText: [], payCustom: [],
      };
    });

    items.forEach((it, i) => {
      const cd = catData[it.category];
      const y = parseFloat(it.amount);
      if (it.period_start && it.period_end) {
        cd.periodLineX.push(it.period_start, it.period_end, null);
        cd.periodLineY.push(y, y, null);
      }
      if (it.period_end && it.invoice_date) {
        cd.lagLineX.push(it.period_end, it.invoice_date, null);
        cd.lagLineY.push(y, y, null);
      }
      if (it.invoice_date) {
        cd.waitLineX.push(it.invoice_date, it.date, null);
        cd.waitLineY.push(y, y, null);
        cd.invX.push(it.invoice_date);
        cd.invY.push(y);
      }
      cd.payX.push(it.date);
      cd.payY.push(y);
      cd.payCustom.push(i);
      const lag = it.period_end ? days(it.period_end, it.date) : null;
      const periodDays = (it.period_start && it.period_end)
        ? daysInclusive(it.period_start, it.period_end) : null;
      cd.payText.push(
        '<b>' + escapeHtml(it.description) + '</b><br>' +
        (it.period_start
          ? 'Period: ' + it.period_start + ' → ' + it.period_end +
            ' (' + periodDays + ' day' + (periodDays === 1 ? '' : 's') + ')<br>'
          : '') +
        (it.invoice_date ? 'Invoice: ' + it.invoice_date + '<br>' : '') +
        'Payment: ' + it.date + '<br>' +
        formatAmount(it.amount) +
        (lag !== null ? '<br>Lag (period→payment): ' + lag + ' days' : '')
      );
    });

    const traces = [];
    cats.forEach(cat => {
      const cd = catData[cat];
      const c = colorMap[cat];
      traces.push(
        { x: cd.periodLineX, y: cd.periodLineY, mode: 'lines+markers',
          type: 'scatter',
          line: { color: c, width: 9 },
          marker: { color: c, size: 6, symbol: 'line-ns-open' },
          hoverinfo: 'skip', showlegend: false, name: '' },
        { x: cd.lagLineX, y: cd.lagLineY, mode: 'lines', type: 'scatter',
          line: { color: c, width: 2 },
          hoverinfo: 'skip', showlegend: false, name: '' },
        { x: cd.waitLineX, y: cd.waitLineY, mode: 'lines', type: 'scatter',
          line: { color: c, width: 2, dash: 'dot' },
          hoverinfo: 'skip', showlegend: false, name: '' },
        { x: cd.invX, y: cd.invY, mode: 'markers', type: 'scatter',
          marker: { color: c, size: 11, symbol: 'diamond' },
          hoverinfo: 'skip', showlegend: false, name: '' },
        // The single hoverable trace per category.
        { x: cd.payX, y: cd.payY, text: cd.payText, customdata: cd.payCustom,
          mode: 'markers', type: 'scatter',
          marker: { color: c, size: 13 },
          hovertemplate: '%{text}<extra></extra>',
          hoverlabel: { bgcolor: darken(c, 0.25), bordercolor: c,
                        font: { color: '#fff' } },
          showlegend: false, name: '' },
      );
    });

    Plotly.newPlot('chart-timeline', traces, Object.assign({}, STATIC_LAYOUT_BASE, {
      hovermode: 'closest',
      yaxis: { title: 'Amount (' + data.currency + ')' },
    }), STATIC_CONFIG);
    const div = document.getElementById('chart-timeline');
    div.on('plotly_click', evt => {
      const cd = evt.points[0].customdata;
      if (cd !== null && cd !== undefined) highlightItems([cd]);
    });
    attachPointerCursor(div);
  }

  function escapeHtml(s) {
    return s.replace(/[&<>"']/g, c => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    }[c]));
  }

  document.getElementById('year-tabs').addEventListener('click', e => {
    if (!e.target.classList.contains('year-tab')) return;
    document.querySelectorAll('.year-tab').forEach(t => t.classList.remove('active'));
    e.target.classList.add('active');
    activeYear = e.target.dataset.year;
    render();
  });

  render();
})();
</script>

</body>
</html>
