<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Home Expenses Report · {{ model.generated_at }}</title>
<style>
  body { background: #1a1a1a; color: #ddd; font-family: -apple-system, BlinkMacSystemFont, sans-serif; margin: 0; padding: 24px; }
  h1, h2, h3 { color: #fff; }
  .header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 16px; }
  .year-tabs { display: flex; gap: 4px; }
  .year-tab { padding: 6px 12px; background: #2d2d2d; border: 1px solid #555; border-radius: 4px; font-size: 12px; color: #ccc; cursor: pointer; }
  .year-tab.active { background: #094771; border-color: #007acc; color: #fff; }
  .section { margin: 24px 0; padding: 16px; background: #1f1f1f; border-radius: 8px; border: 1px solid #333; }
  .alert { padding: 8px 12px; background: #3a1e1e; border-left: 4px solid #f48771; margin: 6px 0; border-radius: 4px; }
  .kpi-row { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; }
  .kpi { background: #2d2d2d; padding: 16px; border-radius: 6px; text-align: center; }
  .kpi .big { font-size: 24px; font-weight: bold; color: #4ec9b0; }
  .kpi .label { font-size: 11px; color: #aaa; text-transform: uppercase; }
  .item-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .item-table th, .item-table td { padding: 6px 10px; text-align: left; border-bottom: 1px solid #333; }
  .item-table th { color: #888; text-transform: uppercase; font-size: 11px; }
  .item-table tr.highlighted { background: #094771; }
  a { color: #4ec9b0; text-decoration: none; }
  .chart-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  /* Static charts: default cursor everywhere; only flip to pointer when the
     hover handler marks a data point under the cursor. */
  #chart-spent, #chart-spent *,
  #chart-consumed, #chart-consumed *,
  #chart-timeline, #chart-timeline * { cursor: default; }
  #chart-spent.cursor-pointer, #chart-spent.cursor-pointer *,
  #chart-consumed.cursor-pointer, #chart-consumed.cursor-pointer *,
  #chart-timeline.cursor-pointer, #chart-timeline.cursor-pointer * {
    cursor: pointer !important;
  }
</style>
</head>
<body>

<div class="header">
  <h1>Home Expenses · {{ model.generated_at }}</h1>
  <div class="year-tabs" id="year-tabs">
    <div class="year-tab active" data-year="all">All</div>
    {% for y in model.years %}
    <div class="year-tab" data-year="{{ y }}">{{ y }}</div>
    {% endfor %}
  </div>
</div>

<div class="section">
  <h2>Alerts</h2>
  {% if model.alerts %}
    {% for a in model.alerts %}
      <div class="alert" data-kind="{{ a.kind.value }}">
        <strong>{{ a.kind.value }}</strong> — {{ a.message }}
      </div>
    {% endfor %}
  {% else %}
    <p>No alerts. Everything reconciles.</p>
  {% endif %}
</div>

<div class="section">
  <h2>Summary</h2>
  <div class="kpi-row">
    <div class="kpi"><div class="big" id="kpi-total">—</div><div class="label">Total ({{ model.currency }})</div></div>
    <div class="kpi"><div class="big" id="kpi-txns">—</div><div class="label">Transactions</div></div>
    <div class="kpi"><div class="big" id="kpi-cats">—</div><div class="label">Categories</div></div>
    <div class="kpi"><div class="big" id="kpi-lag">—</div><div class="label">Avg lag (days)</div></div>
    <div class="kpi"><div class="big" id="kpi-alerts">{{ model.alerts | length }}</div><div class="label">Open alerts</div></div>
  </div>
</div>

<div class="section">
  <h2>Monthly spend <small style="color:#888;font-weight:normal">(when the bank charged)</small></h2>
  <div id="chart-spent"></div>
</div>

<div class="section">
  <h2>Monthly consumption <small style="color:#888;font-weight:normal">(when the service was used; periods spanning &gt;1 month split proportionally by day count)</small></h2>
  <div id="chart-consumed"></div>
</div>

<div class="chart-row">
  <div class="section">
    <h2>By category</h2>
    <div id="chart-donut"></div>
  </div>
  <div class="section">
    <h2>Recurring</h2>
    <div id="recurring-grid">(grid will be populated by JS)</div>
  </div>
</div>

<div class="section">
  <h2>Timeline</h2>
  <div id="chart-timeline"></div>
</div>

<div class="section">
  <h2>Items</h2>
  <table class="item-table" id="items">
    <thead>
      <tr>
        <th>Period</th><th>Invoice date</th><th>Payment date</th><th>Description</th><th>Amount</th>
        <th>Category</th><th>Invoice</th>
      </tr>
    </thead>
    <tbody id="items-body">
      {% for it in model.items|sort(attribute='transaction.date', reverse=True) %}
      <tr id="item-{{ loop.index0 }}" data-item-id="{{ loop.index0 }}">
        <td>{% if it.invoice %}{{ it.invoice.period.start }} → {{ it.invoice.period.end }}{% endif %}</td>
        <td>{% if it.invoice %}{{ it.invoice.invoice_date }}{% endif %}</td>
        <td>{{ it.transaction.date }}</td>
        <td>{{ it.transaction.description }}</td>
        <td>{{ it.transaction.amount }}</td>
        <td>{{ it.category }}</td>
        <td>{% if it.invoice %}<a href="file://{{ it.invoice.source_path }}" target="_blank">📎</a>{% endif %}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>

<script>{{ plotly_js | safe }}</script>
<script id="model-data" type="application/json">{{ data_json | safe }}</script>
<script>
(function () {
  const data = JSON.parse(document.getElementById('model-data').textContent);
  let activeYear = 'all';

  function filtered() {
    if (activeYear === 'all') return data.items;
    return data.items.filter(it => it.date.startsWith(activeYear + '-'));
  }

  const PALETTE = [
    '#4ec9b0', '#f48771', '#dcdcaa', '#9cdcfe', '#c586c0', '#ce9178',
    '#569cd6', '#b5cea8', '#d7ba7d', '#646695', '#4fc1ff', '#d16969',
  ];

  function buildCategoryColors(allItems) {
    // Build the map from the ENTIRE dataset so colors stay stable across
    // year filters (the same category always gets the same color).
    const cats = Array.from(new Set(allItems.map(it => it.category))).sort();
    const map = {};
    cats.forEach((cat, i) => { map[cat] = PALETTE[i % PALETTE.length]; });
    return map;
  }

  function highlightItems(ids) {
    if (!ids || ids.length === 0) return;
    let first = null;
    ids.forEach(id => {
      const row = document.getElementById('item-' + id);
      if (row) {
        row.classList.add('highlighted');
        setTimeout(() => row.classList.remove('highlighted'), 2000);
        if (first === null) first = row;
      }
    });
    if (first) first.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  function attachPointerCursor(div) {
    // Use a CSS class with !important to override Plotly's internal cursor
    // (its draglayer sets crosshair/default depending on dragmode).
    div.on('plotly_hover', () => div.classList.add('cursor-pointer'));
    div.on('plotly_unhover', () => div.classList.remove('cursor-pointer'));
  }

  // Plotly config / layout shared by both interactive charts: no zoom, no
  // pan, no double-click reset — just hover + click + the click handlers
  // attached per chart.
  const STATIC_CONFIG = { displayModeBar: false, scrollZoom: false, doubleClick: false };
  const STATIC_LAYOUT_BASE = {
    dragmode: false,
    paper_bgcolor: '#1f1f1f',
    plot_bgcolor: '#1f1f1f',
    font: { color: '#ddd' },
    margin: { t: 20 },
  };

  const colorMap = buildCategoryColors(data.items);

  // ---- date helpers ----
  function days(a, b) { return Math.round((Date.parse(b) - Date.parse(a)) / 86400000); }
  function daysInclusive(a, b) { return days(a, b) + 1; }
  function splitPeriodAcrossMonths(start, end) {
    // Returns { 'YYYY-MM': fraction } summing to 1 across the months the
    // period covers, weighted by day count in each month.
    const out = {};
    const total = daysInclusive(start, end);
    let cur = new Date(start + 'T00:00:00');
    const endD = new Date(end + 'T00:00:00');
    while (cur <= endD) {
      const y = cur.getFullYear();
      const m = cur.getMonth();
      const monthEnd = new Date(y, m + 1, 0);
      const sliceEnd = monthEnd <= endD ? monthEnd : endD;
      const key = String(y) + '-' + String(m + 1).padStart(2, '0');
      const sliceDays = Math.round((sliceEnd - cur) / 86400000) + 1;
      out[key] = (out[key] || 0) + sliceDays / total;
      cur = new Date(y, m + 1, 1);
    }
    return out;
  }

  function render() {
    const items = filtered();
    document.getElementById('kpi-total').textContent =
      items.reduce((s, it) => s + parseFloat(it.amount), 0).toFixed(2);
    document.getElementById('kpi-txns').textContent = items.length;
    document.getElementById('kpi-cats').textContent =
      new Set(items.map(it => it.category)).size;
    document.getElementById('kpi-lag').textContent = computeAvgLag(items);
    renderItemsTable(items);
    renderSpent(items);
    renderConsumed(items);
    renderDonut(items);
    renderTimeline(items);
  }

  function computeAvgLag(items) {
    const lags = items
      .filter(it => it.period_end && it.date)
      .map(it => days(it.period_end, it.date));
    if (lags.length === 0) return '—';
    return Math.round(lags.reduce((s, n) => s + n, 0) / lags.length);
  }

  function renderItemsTable(items) {
    // data.items is pre-sorted by date desc upstream; `items` (filtered)
    // preserves that order, so simple iteration produces a desc table.
    const tbody = document.getElementById('items-body');
    tbody.innerHTML = '';
    items.forEach((it, idx) => {
      const tr = document.createElement('tr');
      tr.id = 'item-' + idx;
      tr.dataset.itemId = idx;
      let periodCell = '';
      if (it.period_start && it.period_end) {
        const d = daysInclusive(it.period_start, it.period_end);
        periodCell = it.period_start + ' → ' + it.period_end +
          ' (' + d + ' day' + (d === 1 ? '' : 's') + ')';
      }
      tr.innerHTML =
        '<td>' + periodCell + '</td>' +
        '<td>' + (it.invoice_date || '') + '</td>' +
        '<td>' + it.date + '</td>' +
        '<td>' + escapeHtml(it.description) + '</td>' +
        '<td>' + it.amount + '</td>' +
        '<td>' + escapeHtml(it.category) + '</td>' +
        '<td>' + (it.invoice_path
          ? '<a href="file://' + escapeHtml(it.invoice_path) + '" target="_blank">📎</a>'
          : '') + '</td>';
      tbody.appendChild(tr);
    });
  }

  // Builds a stacked-bar monthly chart, aggregating amounts under a
  // category-supplied attribution rule. `attribute(item)` returns a map of
  // 'YYYY-MM' → amount (allowing one item to contribute to many months).
  function renderMonthlyChart(divId, items, attribute) {
    const monthSet = new Set();
    const byCat = {};
    items.forEach(it => {
      const contrib = attribute(it);
      for (const m in contrib) {
        monthSet.add(m);
        byCat[it.category] = byCat[it.category] || {};
        byCat[it.category][m] = (byCat[it.category][m] || 0) + contrib[m];
      }
    });
    const months = Array.from(monthSet).sort();
    const cats = Object.keys(byCat).sort();
    const traces = cats.map(cat => ({
      x: months,
      y: months.map(m => byCat[cat][m] || 0),
      name: cat,
      type: 'bar',
      marker: { color: colorMap[cat] },
      hovertemplate: '<b>' + cat + '</b><br>%{x}<br>%{y:.2f}<extra></extra>',
    }));
    Plotly.newPlot(divId, traces, Object.assign({}, STATIC_LAYOUT_BASE, {
      barmode: 'stack',
    }), STATIC_CONFIG);
    const div = document.getElementById(divId);
    attachPointerCursor(div);
  }

  function renderSpent(items) {
    // Spent: amount lands on the month of the bank charge.
    renderMonthlyChart('chart-spent', items, it => {
      const m = it.date.slice(0, 7);
      return { [m]: parseFloat(it.amount) };
    });
  }

  function renderConsumed(items) {
    // Consumption: only items with a period contribute; amount is split
    // proportionally by day count across the months the period covers.
    renderMonthlyChart('chart-consumed', items, it => {
      if (!it.period_start || !it.period_end) return {};
      const split = splitPeriodAcrossMonths(it.period_start, it.period_end);
      const amount = parseFloat(it.amount);
      const out = {};
      for (const m in split) out[m] = amount * split[m];
      return out;
    });
  }

  function renderDonut(items) {
    const byCat = {};
    items.forEach(it => {
      byCat[it.category] = (byCat[it.category] || 0) + parseFloat(it.amount);
    });
    const labels = Object.keys(byCat);
    Plotly.newPlot('chart-donut', [{
      labels: labels,
      values: Object.values(byCat),
      type: 'pie',
      hole: 0.5,
      marker: { colors: labels.map(c => colorMap[c]) },
      sort: false,
    }], { paper_bgcolor: '#1f1f1f', font: { color: '#ddd' }, margin: { t: 20 } }, { displayModeBar: false });
  }

  function renderTimeline(items) {
    // Each item is drawn at y=amount as a horizontal "lifecycle":
    //   - thick teal bar from period_start to period_end (consumption window)
    //   - thin gray solid line from period_end to invoice_date
    //   - thin orange dotted line from invoice_date to payment_date
    //   - yellow diamond marker at invoice_date
    //   - orange large dot at payment_date (the ONLY hoverable element)
    // The payment dot's tooltip carries the full lifecycle info.
    const periodLineX = [], periodLineY = [];
    const lagLineX = [], lagLineY = [];
    const waitLineX = [], waitLineY = [];
    const invX = [], invY = [];
    const payX = [], payY = [], payText = [], payCustom = [];

    items.forEach((it, i) => {
      const y = parseFloat(it.amount);
      if (it.period_start && it.period_end) {
        periodLineX.push(it.period_start, it.period_end, null);
        periodLineY.push(y, y, null);
      }
      if (it.period_end && it.invoice_date) {
        lagLineX.push(it.period_end, it.invoice_date, null);
        lagLineY.push(y, y, null);
      }
      if (it.invoice_date) {
        waitLineX.push(it.invoice_date, it.date, null);
        waitLineY.push(y, y, null);
        invX.push(it.invoice_date);
        invY.push(y);
      }
      payX.push(it.date);
      payY.push(y);
      payCustom.push(i);
      const lag = it.period_end ? days(it.period_end, it.date) : null;
      const periodDays = (it.period_start && it.period_end)
        ? daysInclusive(it.period_start, it.period_end) : null;
      payText.push(
        '<b>' + escapeHtml(it.description) + '</b><br>' +
        (it.period_start
          ? 'Period: ' + it.period_start + ' → ' + it.period_end +
            ' (' + periodDays + ' day' + (periodDays === 1 ? '' : 's') + ')<br>'
          : '') +
        (it.invoice_date ? 'Invoice: ' + it.invoice_date + '<br>' : '') +
        'Payment: ' + it.date + '<br>' +
        it.amount +
        (lag !== null ? '<br>Lag (period→payment): ' + lag + ' days' : '')
      );
    });

    const traces = [
      { x: periodLineX, y: periodLineY, mode: 'lines+markers', type: 'scatter',
        line: { color: '#4ec9b0', width: 9 },
        marker: { color: '#4ec9b0', size: 6, symbol: 'line-ns-open' },
        hoverinfo: 'skip', showlegend: false, name: '' },
      { x: lagLineX, y: lagLineY, mode: 'lines', type: 'scatter',
        line: { color: '#888', width: 2 },
        hoverinfo: 'skip', showlegend: false, name: '' },
      { x: waitLineX, y: waitLineY, mode: 'lines', type: 'scatter',
        line: { color: '#f48771', width: 2, dash: 'dot' },
        hoverinfo: 'skip', showlegend: false, name: '' },
      { x: invX, y: invY, mode: 'markers', type: 'scatter',
        marker: { color: '#dcdcaa', size: 10, symbol: 'diamond' },
        hoverinfo: 'skip', showlegend: false, name: '' },
      // The single hoverable trace.
      { x: payX, y: payY, text: payText, customdata: payCustom,
        mode: 'markers', type: 'scatter',
        marker: { color: '#f48771', size: 13 },
        hovertemplate: '%{text}<extra></extra>',
        hoverlabel: { bgcolor: '#3a1e1e', bordercolor: '#f48771',
                      font: { color: '#ffe6dc' } },
        showlegend: false, name: '' },
    ];

    Plotly.newPlot('chart-timeline', traces, Object.assign({}, STATIC_LAYOUT_BASE, {
      hovermode: 'closest',
      yaxis: { title: 'Amount (' + data.currency + ')' },
    }), STATIC_CONFIG);
    const div = document.getElementById('chart-timeline');
    div.on('plotly_click', evt => {
      const cd = evt.points[0].customdata;
      if (cd !== null && cd !== undefined) highlightItems([cd]);
    });
    attachPointerCursor(div);
  }

  function escapeHtml(s) {
    return s.replace(/[&<>"']/g, c => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    }[c]));
  }

  document.getElementById('year-tabs').addEventListener('click', e => {
    if (!e.target.classList.contains('year-tab')) return;
    document.querySelectorAll('.year-tab').forEach(t => t.classList.remove('active'));
    e.target.classList.add('active');
    activeYear = e.target.dataset.year;
    render();
  });

  render();
})();
</script>

</body>
</html>
